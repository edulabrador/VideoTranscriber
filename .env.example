# Path to a Netscape-format cookies.txt exported from your browser (needed for
# private/login-gated Instagram content). Leave unset for public content only.
COOKIES_FILE=

# Optional local Cobalt instance, used only when yt-dlp cannot download TikTok or X.
COBALT_API_URL=http://127.0.0.1:9187

# "auto" selects large-v3-turbo on both GPU and CPU.
MODEL_SIZE=auto

# "auto" detects CUDA vs CPU. Override with "cpu" or "cuda".
DEVICE=auto

# "auto" selects a compute type according to CUDA support and available VRAM.
COMPUTE_TYPE=auto

# 0 selects a conservative GPU batch from the available VRAM.
BATCH_SIZE=0

# One decoding candidate favors speed. Increase to 5 if maximum accuracy matters more.
BEAM_SIZE=1

# Maximum accepted upload size in bytes (512 MiB).
MAX_UPLOAD_BYTES=536870912

# Maximum time for preparing an uploaded audio/video file (seconds).
AUDIO_PREPARATION_TIMEOUT_SECONDS=600

# Whisper models kept between jobs. On CUDA only the active one uses VRAM; the rest wait in RAM.
MAX_CACHED_MODELS=2

# Free the models after this many idle seconds. 0 keeps them loaded.
MODEL_IDLE_UNLOAD_SECONDS=900

# Speaker grouping when the number of speakers is not given. Higher means fewer speakers.
DIARIZATION_THRESHOLD=0.5

# Transcripts kept in the history; past this, the oldest one and its files are deleted.
MAX_HISTORY_ENTRIES=1000

# Keep a small audio copy (about 20 MB per hour) to play next to the transcript.
KEEP_AUDIO=true

# Optional local summaries with Ollama. Leave OLLAMA_URL empty to hide them;
# leave OLLAMA_MODEL empty to use the first installed model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

API_PORT=8187
WEB_PORT=5187
