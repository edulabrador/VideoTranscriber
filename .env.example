# Path to a Netscape-format cookies.txt exported from your browser (needed for
# private/login-gated Instagram content). Leave unset for public content only.
COOKIES_FILE=

# Local Cobalt instance used for TikTok downloads.
COBALT_API_URL=http://127.0.0.1:9187

# "auto" selects large-v3-turbo on both GPU and CPU.
MODEL_SIZE=auto

# "auto" detects CUDA vs CPU. Override with "cpu" or "cuda".
DEVICE=auto

# "auto" selects a compute type according to CUDA support and available VRAM.
COMPUTE_TYPE=auto

# 0 selects a conservative GPU batch from the available VRAM.
BATCH_SIZE=0

# One decoding candidate favors speed. Increase to 5 if maximum accuracy matters more.
BEAM_SIZE=1

API_PORT=8187
WEB_PORT=5187
